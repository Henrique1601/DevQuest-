# Conexão com o Neon Serverless Postgres
# Exemplo: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# URLs de Produção e NextAuth
NEXT_PUBLIC_APP_URL="https://devquest-zeta.vercel.app"
NEXT_APP_URL="https://devquest-zeta.vercel.app/"
AUTH_URL="https://devquest-zeta.vercel.app"
AUTH_SECRET="gere-um-segredo-com-npx-auth-secret"
AUTH_TRUST_HOST="true"

# Provedores OAuth (Opcionais)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
